{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asterism-site",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/site",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "asterism.adityapandya.com",
      "custom_domain": true
    }
  ]
}
