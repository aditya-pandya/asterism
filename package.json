{
  "name": "asterism",
  "productName": "Asterism",
  "version": "1.1.0",
  "description": "A premium, privacy-first rich text and Markdown converter for the browser and macOS desktop.",
  "author": "Aditya Pandya",
  "license": "MIT",
  "homepage": "https://github.com/aditya-pandya/asterism",
  "repository": {
    "type": "git",
    "url": "https://github.com/aditya-pandya/asterism.git"
  },
  "bugs": {
    "url": "https://github.com/aditya-pandya/asterism/issues"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac dir --arm64",
    "dist:mac": "electron-builder --mac dmg zip --arm64",
    "tauri:dev": "node scripts/run-tauri.js dev",
    "tauri:build": "node scripts/run-tauri.js build --target aarch64-apple-darwin"
  },
  "build": {
    "appId": "com.apandya.inkdown",
    "productName": "Asterism",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack.js",
    "files": [
      "electron/**/*",
      "assets/**/*",
      "index.html",
      "styles.css",
      "app.js",
      "clear-storage.html",
      "favicon.svg",
      "vendor/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip",
        "dir"
      ],
      "fileAssociations": [
        {
          "ext": ["md", "markdown"],
          "name": "Markdown Document",
          "role": "Viewer",
          "mimeType": "text/markdown"
        },
        {
          "ext": ["txt"],
          "name": "Text Document",
          "role": "Viewer",
          "mimeType": "text/plain"
        }
      ]
    }
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "electron": "42.0.0",
    "electron-builder": "26.8.1"
  }
}
